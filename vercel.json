{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/*.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/ai/solve",
      "destination": "/api/solve"
    },
    {
      "source": "/api/ai/chat",
      "destination": "/api/chat"
    },
    {
      "source": "/api/ai/learn",
      "destination": "/api/learn"
    },
    {
      "source": "/api/ai/transcribe",
      "destination": "/api/transcribe"
    },
    {
      "source": "/api/ai/handwriting",
      "destination": "/api/handwriting"
    },
    {
      "source": "/api/ai/whiteboard",
      "destination": "/api/whiteboard"
    },
    {
      "source": "/api/ai/socratic",
      "destination": "/api/socratic"
    },
    {
      "source": "/api/ai/research",
      "destination": "/api/research"
    },
    {
      "source": "/api/ai/document-tutor",
      "destination": "/api/document-tutor"
    },
    {
      "source": "/api/ai/voice-math",
      "destination": "/api/voice-math"
    },
    {
      "source": "/api/learn/follow-up",
      "destination": "/api/learn?action=follow_up"
    },
    {
      "source": "/api/learn/formula-questions",
      "destination": "/api/learn?action=formula_questions"
    },
    {
      "source": "/api/auth/:path*",
      "destination": "/api/auth?__authPath=:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    }
  ]
}
