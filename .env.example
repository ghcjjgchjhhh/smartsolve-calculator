# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL / AUTH_URL: The public URL where SmartSolve is hosted (e.g. https://your-app.vercel.app)
APP_URL="MY_APP_URL"
AUTH_URL=""

# Auth.js & Google OAuth (Server-side only — NEVER prefix with VITE_)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
AUTH_SECRET=""
AUTH_TRUST_HOST="true"

# Optional Backend API Base URL (Leave empty when frontend and /api/* share the same domain)
VITE_API_BASE_URL=""
